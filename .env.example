# Last.fm API shared secret (server-only; never use a VITE_ prefix).
# Create an API account at https://www.last.fm/api/account/create
LASTFM_SHARED_SECRET=

# Hack Club AI proxy key (server-only). Get one at https://ai.hackclub.com
HACKCLUB_AI_API_KEY=
# Optional overrides. Defaults: openai/gpt-4o-mini, then google/gemini-2.5-flash.
# AI_MODEL=
# AI_FALLBACK_MODEL=
# AI_BASE_URL=https://ai.hackclub.com/proxy/v1

# Optional: best-effort per-instance limits for /api/vibe and /api/compare (requests per 10 minutes)
# AI_RATE_LIMIT_PER_IP=12
# AI_RATE_LIMIT_GLOBAL=300
